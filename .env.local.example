# Copy this file to .env.local and fill in your real values. .env.local is
# git-ignored, so your keys never end up on GitHub.
#
# Six variables in total. Which ones you need depends on where you are:
#
#   Local dev      NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#                  ANTHROPIC_API_KEY  (+ SUPABASE_DB_URL only if you run backups)
#   Vercel         NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#                  ANTHROPIC_API_KEY  (+ CSP_REPORT_URI if you have a collector)
#                  — never put SUPABASE_DB_URL on Vercel.
#
# BUILD-TIME vs RUNTIME. Anything starting with NEXT_PUBLIC_ is read at BUILD
# time and baked into the JavaScript sent to the browser. Changing one of those
# on Vercel does nothing until you REDEPLOY. CSP_REPORT_URI is also read at
# build time (next.config.mjs). ANTHROPIC_API_KEY is read at request time on
# the server, so changing it takes effect on the next request.


# ── Supabase (required) ─────────────────────────────────────────────────────
# From Supabase → Project Settings → API.
# BUILD-TIME + PUBLIC: both of these are inlined into the browser bundle. That
# is correct and expected — the anon key is designed to be public, and every
# table is protected by row-level security keyed to the signed-in user.
# Without these two the app never shows the sign-in gate and runs local-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here


# ── Anthropic (required for AI schedule reading) ────────────────────────────
# Used by app/api/parse-schedule. RUNTIME, SERVER ONLY.
# Never rename this to NEXT_PUBLIC_ANTHROPIC_API_KEY (or add a NEXT_PUBLIC_
# prefix to any secret): anything starting with NEXT_PUBLIC_ is baked into the
# JavaScript sent to every browser, so the key would be public and anyone could
# spend against your account.
# Set a monthly spend limit on this key in the Anthropic Console before anyone
# else can sign up — see docs/LAUNCH.md.
ANTHROPIC_API_KEY=sk-ant-your-key-here


# ── Database backups (optional, LOCAL ONLY) ─────────────────────────────────
# Required by scripts/backup-db.sh (`npm run backup`), which exits 1 without it.
# This is the "Session pooler" connection string from the Supabase dashboard
# (Connect button, top of the dashboard), with [YOUR-PASSWORD] replaced by the
# real database password.
#
# This is a FULL-ACCESS database credential — it bypasses row-level security
# entirely. Keep it in .env.local on your own machine and NOWHERE ELSE. Do not
# add it to Vercel, to CI, or to any shared environment; the app never reads it.
# SUPABASE_DB_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres


# ── CSP violation reports (optional) ────────────────────────────────────────
# BUILD-TIME. Read by next.config.mjs. When set, the report-only Content
# Security Policy adds `report-uri <value>` and violations are POSTed there.
# Leave it unset unless you have a real collector — a report-uri pointing
# nowhere reads as monitoring but collects nothing. Changing it requires a
# redeploy.
# CSP_REPORT_URI=https://your-collector.example.com/csp

# Optional. The model used to read uploaded schedules. Leave unset to use the
# validated default. Set to claude-opus-5 to trial the newer model (same price)
# — check it against real schedules before leaving it on, because everything
# downstream of this is somebody's crowd budget. Server-side only.
SCHEDULE_READER_MODEL=
