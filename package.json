{
  "name": "crowdos-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --no-lint",
    "start": "next start",
    "test": "TZ=Europe/London vitest run",
    "build:check": "NEXT_DIST_DIR=.next-check next build --no-lint",
    "backup": "bash scripts/backup-db.sh",
    "typecheck": "tsc --noEmit",
    "typecheck:js": "tsc -p tsconfig.checkjs.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ratchet": "node scripts/ratchet.mjs",
    "ratchet:update": "node scripts/ratchet.mjs --update",
    "verify": "npm run ratchet && npm run typecheck && npm test && npm run build:check"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@supabase/supabase-js": "^2.45.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "next": "^15.3.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
